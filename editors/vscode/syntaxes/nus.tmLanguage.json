{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NUS",
  "scopeName": "source.nus",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nus",
          "match": "//.*$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.nus",
          "begin": "\\br(#+)\\\"",
          "end": "\\\"\\1",
          "patterns": []
        },
        {
          "name": "string.quoted.other.raw.nus",
          "match": "\\br\\\"[^\\\"]*\\\""
        },
        {
          "name": "string.quoted.double.byte.nus",
          "begin": "\\bb\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.nus",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.nus",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.nus",
              "match": "\\\\(?:[nrt0\\\\\\\"']|x[0-9A-Fa-f]{2})"
            }
          ]
        },
        {
          "name": "constant.character.byte.nus",
          "match": "\\bb'(?:\\\\.|[^'\\n])'"
        },
        {
          "name": "constant.character.nus",
          "match": "'(?:\\\\.|[^'\\n])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hex.nus",
          "match": "\\b0[xX][0-9A-Fa-f_]+(?:[iu](?:8|16|32|64|size))?\\b"
        },
        {
          "name": "constant.numeric.integer.binary.nus",
          "match": "\\b0[bB][01_]+(?:[iu](?:8|16|32|64|size))?\\b"
        },
        {
          "name": "constant.numeric.integer.octal.nus",
          "match": "\\b0[oO][0-7_]+(?:[iu](?:8|16|32|64|size))?\\b"
        },
        {
          "name": "constant.numeric.float.nus",
          "match": "\\b(?:[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*)(?:f(?:32|64))?\\b"
        },
        {
          "name": "constant.numeric.integer.nus",
          "match": "\\b[0-9][0-9_]*(?:[iu](?:8|16|32|64|size))?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.nus"
            },
            "2": {
              "name": "entity.name.function.nus"
            }
          }
        },
        {
          "match": "\\b(struct|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.nus"
            },
            "2": {
              "name": "entity.name.type.nus"
            }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.nus"
            },
            "2": {
              "name": "entity.name.type.alias.nus"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nus",
          "match": "\\b(?:as|async|await|break|continue|defer|else|for|if|in|loop|match|return|scope|spawn|unsafe|while)\\b"
        },
        {
          "name": "storage.type.nus",
          "match": "\\b(?:const|enum|extern|fn|impl|let|pub|static|struct|trait|type|use)\\b"
        },
        {
          "name": "storage.modifier.nus",
          "match": "\\b(?:mut|move|ref)\\b"
        },
        {
          "name": "keyword.other.reserved.nus",
          "match": "\\b(?:link|network|node|protocol|service|simulate|where)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.nus",
          "match": "\\b(?:bool|char|string|bytes|unit|never|i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64)\\b"
        },
        {
          "name": "support.type.builtin.nus",
          "match": "\\b(?:Vec|VecIter|VecRefIter|VecMutIter|Option|Result|IpAddr|SocketAddr|NetworkError|TcpStream|TcpListener|UdpSocket)\\b"
        },
        {
          "name": "variable.language.self.nus",
          "match": "\\bself\\b"
        },
        {
          "name": "support.type.self.nus",
          "match": "\\bSelf\\b"
        },
        {
          "name": "entity.name.type.nus",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.nus",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.variant.nus",
          "match": "\\b(?:Some|None|Ok|Err)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.annotation.nus",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.nus",
          "match": "\\b(?:print|assert|string_clone|string_len|vec_new|vec_push|vec_len|vec_get|some|none|ok|err|ipv4|socket_addr|socket_port|network_error_code|network_error_reason|dns_resolve_ipv4|tcp_connect|tcp_listen|tcp_accept|tcp_set_nodelay|tcp_set_timeout|tcp_send|tcp_receive|udp_bind|udp_send_to|udp_receive)\\b(?=\\s*(?:::<[^>]+>)?\\s*\\()"
        },
        {
          "name": "entity.name.function.call.nus",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*(?:::<[^>]+>)?\\s*\\()"
        },
        {
          "name": "entity.name.function.method.nus",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.member.nus",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nus",
          "match": "(?:\\?|(=>)|(->)|(::)|(\\.\\.=?)|(<<=?|>>=?)|(&&|\\|\\|)|([+\\-*/%&|^]=?)|([=!<>]=?)|[~])"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.nus",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    }
  }
}
