fn process(buffer: bytes, count: usize) {
    let slice = buffer[0..count];
    print(slice);
}

fn main() {
    let mut attempts = 0;
    let buffer = [0; 4096];

    while attempts < 3 {
        attempts += 1;
    }

    for index in 0..=10 {
        if index == 5 {
            continue;
        }

        print(buffer[index]);
    }

    loop {
        runtime.poll();
        break;
    }
}
