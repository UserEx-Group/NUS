trait NetworkValue {}

struct Packet {
    source: u32,
    destination: u32,
    payload_size: usize,
}

impl NetworkValue for Packet {}

impl Packet {
    fn route_key(&self) -> u32 {
        self.source + self.destination
    }

    fn set_source(&mut self, source: u32) {
        self.source = source;
    }

    fn consume(self) {
        print(self.source, self.destination, self.payload_size);
    }
}

fn identity<T>(value: T) -> T {
    value
}

fn route_class<T: NetworkValue>(value: &T) -> i32 {
    1
}

fn inspect(packet: &Packet) {
    print(packet.route_key());
}

fn rewrite(packet: &mut Packet, source: u32) {
    packet.source = source;
}

enum RouteStatus {
    Ready(i32),
    Offline,
}

fn route_port(okay: bool) -> Result<i32, string> {
    let message = "route offline";
    let result = if okay {
        ok::<i32, string>(8080)
    } else {
        err::<i32, string>(string_clone(&message))
    };
    let port = result?;

    ok::<i32, string>(port + 1)
}

fn main() {
    let mut packet = Packet {
        source: 10,
        destination: 20,
        payload_size: 1500,
    };

    inspect(&packet);
    rewrite(&mut packet, 42);

    let view = &packet;
    print(view.source, view.payload_size);

    // NLL: the shared loan ends after the last use of `view`.
    packet.set_source(64);

    print(route_class(&packet), identity(99));

    let literal = "network";
    let owned = string_clone(&literal);
    print(string_len(&owned), owned);

    let mut samples: Vec<i32> = vec_new::<i32>();
    vec_push(&mut samples, 10);
    vec_push(&mut samples, identity(20));
    vec_push(&mut samples, 30);
    print(vec_len(&samples), vec_get(&samples, 1));

    let item_literal = "owned-in-vector";
    let item = string_clone(&item_literal);
    let mut names: Vec<string> = vec_new::<string>();
    vec_push(&mut names, item);
    print(vec_len(&names));


    let status = RouteStatus::Ready(8080);
    let status_port = match status {
        RouteStatus::Ready(value) => value,
        RouteStatus::Offline => 0,
    };
    print(status_port);

    let routed = route_port(true);
    match routed {
        Ok(value) => print(value),
        Err(_) => print("route-error"),
    }

    packet.consume();
}
