struct Packet {
    source: u32,
    destination: u32,
    payload_size: usize,
}

impl Packet {
    fn route_key(&self) -> u32 {
        self.source + self.destination
    }

    fn set_source(&mut self, source: u32) {
        self.source = source;
    }
}

fn inspect(packet: Packet) -> u32 {
    packet.route_key()
}

fn main() {
    let mut packet = Packet {
        source: 10,
        destination: 20,
        payload_size: 1500,
    };

    packet.set_source(42);
    print(packet.source, packet.payload_size, inspect(packet));
}
