trait NetworkValue {}

trait RouteKey {
    type Output;
    fn route_key(&self) -> Self::Output;
}

trait Counted {
    type Item;
    fn count(&self) -> usize;
}

struct Packet {
    source: u32,
    destination: u32,
    payload_size: usize,
}

impl NetworkValue for Packet {}

impl RouteKey for Packet {
    type Output = u32;

    fn route_key(&self) -> u32 {
        self.source + self.destination
    }
}

impl Packet {
    fn set_source(&mut self, source: u32) {
        self.source = source;
    }

    fn consume(self) {
        print(self.source, self.destination, self.payload_size);
    }
}

impl<T> Counted for Vec<T> {
    type Item = T;

    fn count(&self) -> usize {
        self.len()
    }
}

fn identity<T>(value: T) -> T {
    value
}

fn route_class<T: NetworkValue>(value: &T) -> i32 {
    1
}

fn inspect(packet: &Packet) {
    print(packet.route_key());
}

fn packet_view(packet: &Packet) -> &Packet {
    packet
}

fn rewrite(packet: &mut Packet, source: u32) {
    packet.source = source;
}

enum RouteStatus {
    Ready(i32),
    Offline,
}

fn local_endpoint(port: u16) -> SocketAddr {
    socket_addr(ipv4(127, 0, 0, 1), port)
}

fn connect_native(address: &SocketAddr) -> Result<TcpStream, NetworkError> {
    tcp_connect(address)
}

fn bind_native(address: &SocketAddr) -> Result<UdpSocket, NetworkError> {
    udp_bind(address)
}

fn resolve_native(host: &string) -> Result<IpAddr, NetworkError> {
    dns_resolve_ipv4(host)
}

fn listen_native(address: &SocketAddr) -> Result<TcpListener, NetworkError> {
    tcp_listen(address, 64, true)
}

fn accept_native(listener: &mut TcpListener) -> Result<TcpStream, NetworkError> {
    tcp_accept(listener)
}

fn configure_native(stream: &mut TcpStream) -> Result<i32, NetworkError> {
    let _nodelay = tcp_set_nodelay(stream, true)?;
    let _timeout = tcp_set_timeout(stream, 1000u32)?;
    ok::<i32, NetworkError>(0)
}


async fn plus_one(value: i32) -> i32 {
    value + 1
}

async fn async_demo() -> i32 {
    await yield_now();
    let first = await plus_one(40);
    await plus_one(first)
}

async fn task_a() {
    await yield_now();
    print("A");
}

async fn task_b() {
    print("B1");
    await yield_now();
    print("B2");
}

fn executor_demo() {
    let mut executor = executor_new();
    executor_spawn(&mut executor, task_a());
    executor_spawn(&mut executor, task_b());
    executor_run(&mut executor);
}

async fn joined_answer() -> i32 {
    await sleep_ms(5u32);
    42
}

async fn joined_error() -> Result<i32, i32> {
    await yield_now();
    err::<i32, i32>(7)
}

async fn scoped_add_one(value: &mut i32) {
    await yield_now();
    *value += 1;
}

fn structured_concurrency_demo() {
    let mut executor = executor_new();
    let handle = task_spawn(&mut executor, joined_answer());
    let joined = task_join(&mut executor, handle);
    match joined {
        Some(value) => print(value),
        None => print(-1),
    };

    let error_handle = task_spawn(&mut executor, joined_error());
    let error_joined = task_join(&mut executor, error_handle);
    match error_joined {
        Some(result) => match result {
            Ok(value) => print(value),
            Err(error) => print(-error),
        },
        None => print(-2),
    };

    let mut number = 41;
    let mut tasks = scope_new();
    scope_spawn(&mut tasks, scoped_add_one(&mut number));
    scope_run(&mut tasks);
    print(number);
}

async fn accept_async_native(listener: &mut TcpListener) -> Result<i32, NetworkError> {
    let accepted = await tcp_accept_async(listener);
    let stream = accepted?;
    ok::<i32, NetworkError>(1)
}

fn reactor_probe(address: &SocketAddr) -> Result<usize, NetworkError> {
    let mut listener = tcp_listen(address, 8, true)?;
    let _nonblocking = tcp_listener_set_nonblocking(&mut listener, true)?;
    let mut reactor = reactor_new()?;
    let _registered = reactor_register_listener(&mut reactor, &listener, 1usize)?;
    let _ready = reactor_wait(&mut reactor, 0)?;
    ok::<usize, NetworkError>(reactor_len(&reactor))
}

fn route_port(okay: bool) -> Result<i32, string> {
    let message = "route offline";
    let result = if okay {
        ok::<i32, string>(8080)
    } else {
        err::<i32, string>(string_clone(&message))
    };
    let port = result?;

    ok::<i32, string>(port + 1)
}

fn main() {
    let mut packet = Packet {
        source: 10,
        destination: 20,
        payload_size: 1500,
    };

    inspect(&packet);
    rewrite(&mut packet, 42);

    let view = packet_view(&packet);
    print(view.source, view.payload_size);

    // M14 NLL: the returned reference carries the call-site loan,
    // which ends after the last use of `view`.
    packet.set_source(64);

    print(route_class(&packet), identity(99));

    let literal = "network";
    let owned = string_clone(&literal);
    print(string_len(&owned), owned);

    let mut samples: Vec<i32> = vec_new::<i32>();
    samples.push(10);
    samples.push(identity(20));
    samples.push(30);
    print(samples.count(), samples.get(1));

    let mut sum = 0;
    for sample in samples.iter() {
        sum += *sample;
    }
    print(sum);

    for sample in samples.iter_mut() {
        *sample += 1;
    }
    print(samples.get(0), samples.get(2));

    let item_literal = "owned-in-vector";
    let item = string_clone(&item_literal);
    let mut names: Vec<string> = vec_new::<string>();
    names.push(item);
    // Non-Copy values can now be moved out one iteration at a time.
    for name in names {
        print(name);
    }

    let local = local_endpoint(8080);
    print(socket_port(&local));

    let status = RouteStatus::Ready(8080);
    let status_port = match status {
        RouteStatus::Ready(value) => value,
        RouteStatus::Offline => 0,
    };
    print(status_port);

    let routed = route_port(true);
    match routed {
        Ok(value) => print(value),
        Err(_) => print("route-error"),
    }

    print(block_on(async_demo()));
    executor_demo();
    structured_concurrency_demo();

    packet.consume();
}
